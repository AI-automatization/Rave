NODE_ENV=development
PORT=3009
MONGO_URI=mongodb://cinesync:cinesync_dev_pass@localhost:27017/cinesync_payment?authSource=admin
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=debug

# Internal service communication
INTERNAL_SECRET=your-internal-secret-key

# tezcode-billing (docs/INTEGRATION.md, Abdulaziz) — WeWatch is registered there as
# productCode "WEWATCH", plan "pro" (29 000 so'm/oy, set up 2026-07-04). Get BILLING_API_KEY
# and BILLING_HMAC_SECRET from Abdulaziz ("Шаг 0" in the doc) — apiKey is shown only ONCE at
# creation/rotation, put it straight into Railway env, never log it or commit it.
BILLING_URL=https://pay.tezcode.dev
BILLING_API_KEY=                           # server-to-server secret — shown once, from Abdulaziz
BILLING_HMAC_SECRET=                       # verifies incoming webhook signatures — from Abdulaziz
BILLING_PRODUCT_CODE=WEWATCH
BILLING_PRO_PLAN_SLUG=pro

# Where checkout success/cancel redirects go back to
APP_WEB_BASE_URL=http://localhost:3000
