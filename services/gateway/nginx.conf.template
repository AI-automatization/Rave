# WeWatch API Gateway (nginx) — single entrypoint for all microservices.
# api.wewatch.uz (prod) / dev.api.wewatch.uz (staging) → routes by path prefix.
#
# Railway terminates TLS at the edge, so this listens on plain HTTP on $PORT.
# Upstreams are injected per-environment via env vars (Railway private networking):
#   AUTH_UPSTREAM=auth.railway.internal:3001   (etc.)
# The entrypoint runs envsubst on ONLY these vars, preserving nginx's own $vars.

worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - [$time_local] "$request" $status '
                    '$body_bytes_sent "$http_referer" "$http_user_agent"';
    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    client_max_body_size 50M;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript application/xml;

    limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
    limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;

    # A static `upstream { server host:port; }` block resolves its hostname ONCE, when nginx
    # loads — which is also when `nginx -t` runs in docker-entrypoint.sh, before `exec nginx`.
    # If Railway's private-network DNS for that service isn't answering yet at that exact
    # instant (a real race — confirmed in prod: `host not found in upstream
    # "auth.railway.internal:3001"`, repeating every ~1s until Railway gave up and marked the
    # deploy FAILED), nginx refuses to start at all — for the WHOLE gateway, over ONE upstream
    # being slow, and it never recovers on its own once past that boot window.
    #
    # `resolver` + a `set` + variable `proxy_pass` makes nginx resolve each upstream lazily, at
    # REQUEST time, using this resolver — not at startup. A slow/unready upstream now costs one
    # 502 to whichever request hit it first, not a dead gateway. RESOLVER_IP is read from the
    # container's own /etc/resolv.conf by docker-entrypoint.sh, so this always matches whatever
    # DNS Railway actually wired up for *.railway.internal, not a guessed/hardcoded address.
    # Trade-off: loses the `keepalive` upstream connection pool that a static upstream{} block
    # allows — acceptable here, correctness (starting up, staying up) matters far more than
    # pooling for a gateway currently carrying no production traffic.
    resolver ${RESOLVER_IP} valid=10s ipv6=off;

    server {
        listen ${PORT};
        server_name _;

        # TLS terminated by Railway; mark original scheme as https for downstream services.
        set $fwd_proto https;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        # ── Auth ──────────────────────────────────────────────
        location /api/v1/auth/ {
            limit_req zone=auth burst=10 nodelay;
            set $auth_upstream ${AUTH_UPSTREAM};
            proxy_pass http://$auth_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
        }

        # ── User ──────────────────────────────────────────────
        location /api/v1/users/ {
            limit_req zone=api burst=40 nodelay;
            set $user_upstream ${USER_UPSTREAM};
            proxy_pass http://$user_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
        }

        # ── Content ───────────────────────────────────────────
        location /api/v1/content/ {
            limit_req zone=api burst=40 nodelay;
            set $content_upstream ${CONTENT_UPSTREAM};
            proxy_pass http://$content_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
        }
        location /api/v1/youtube/ {
            set $content_upstream ${CONTENT_UPSTREAM};
            proxy_pass http://$content_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
        }

        # ── Watch Party (REST + WebSocket) ────────────────────
        location /api/v1/watch-party/ {
            limit_req zone=api burst=40 nodelay;
            set $watch_party_upstream ${WATCH_PARTY_UPSTREAM};
            proxy_pass http://$watch_party_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
            proxy_read_timeout 86400;
        }
        location /socket.io/ {
            set $watch_party_upstream ${WATCH_PARTY_UPSTREAM};
            proxy_pass http://$watch_party_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 86400;
        }

        # ── Notifications ─────────────────────────────────────
        location /api/v1/notifications/ {
            limit_req zone=api burst=40 nodelay;
            set $notification_upstream ${NOTIFICATION_UPSTREAM};
            proxy_pass http://$notification_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
        }

        # ── Admin (auth by JWT/role in the service; no IP allow-list on Railway) ──
        location /api/v1/admin/ {
            limit_req zone=auth burst=20 nodelay;
            set $admin_upstream ${ADMIN_UPSTREAM};
            proxy_pass http://$admin_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
        }
        # Admin also serves /api/v1/operator, /api/v1/errors and generic /api/v1 (analytics/support/moderation)
        location /api/v1/operator/ {
            set $admin_upstream ${ADMIN_UPSTREAM};
            proxy_pass http://$admin_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
        }
        location /api/v1/errors/ {
            set $admin_upstream ${ADMIN_UPSTREAM};
            proxy_pass http://$admin_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
        }

        # Gateway health
        location = /health {
            default_type application/json;
            return 200 '{"status":"ok","service":"gateway"}';
        }
    }
}
