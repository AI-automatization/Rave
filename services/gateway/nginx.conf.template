# WeWatch API Gateway (nginx) — single entrypoint for all microservices.
# api.wewatch.uz (prod) / dev.api.wewatch.uz (staging) → routes by path prefix.
#
# Railway terminates TLS at the edge, so this listens on plain HTTP on $PORT.
# Upstreams are injected per-environment via env vars (Railway private networking):
#   AUTH_UPSTREAM=auth.railway.internal:3001   (etc.)
# The entrypoint runs envsubst on ONLY these vars, preserving nginx's own $vars.

worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - [$time_local] "$request" $status '
                    '$body_bytes_sent "$http_referer" "$http_user_agent"';
    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    client_max_body_size 50M;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript application/xml;

    limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
    limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;

    upstream auth_service         { server ${AUTH_UPSTREAM};         keepalive 32; }
    upstream user_service         { server ${USER_UPSTREAM};         keepalive 32; }
    upstream content_service      { server ${CONTENT_UPSTREAM};      keepalive 32; }
    upstream watch_party_service  { server ${WATCH_PARTY_UPSTREAM};  keepalive 32; }
    upstream notification_service { server ${NOTIFICATION_UPSTREAM}; keepalive 32; }
    upstream admin_service        { server ${ADMIN_UPSTREAM};        keepalive 32; }

    server {
        listen ${PORT};
        server_name _;

        # TLS terminated by Railway; mark original scheme as https for downstream services.
        set $fwd_proto https;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        # ── Auth ──────────────────────────────────────────────
        location /api/v1/auth/ {
            limit_req zone=auth burst=10 nodelay;
            proxy_pass http://auth_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
        }

        # ── User ──────────────────────────────────────────────
        location /api/v1/users/ {
            limit_req zone=api burst=40 nodelay;
            proxy_pass http://user_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
        }

        # ── Content ───────────────────────────────────────────
        location /api/v1/content/ {
            limit_req zone=api burst=40 nodelay;
            proxy_pass http://content_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
        }
        location /api/v1/youtube/ {
            proxy_pass http://content_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
        }

        # ── Watch Party (REST + WebSocket) ────────────────────
        location /api/v1/watch-party/ {
            limit_req zone=api burst=40 nodelay;
            proxy_pass http://watch_party_service;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
            proxy_read_timeout 86400;
        }
        location /socket.io/ {
            proxy_pass http://watch_party_service;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 86400;
        }

        # ── Notifications ─────────────────────────────────────
        location /api/v1/notifications/ {
            limit_req zone=api burst=40 nodelay;
            proxy_pass http://notification_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
        }

        # ── Admin (auth by JWT/role in the service; no IP allow-list on Railway) ──
        location /api/v1/admin/ {
            limit_req zone=auth burst=20 nodelay;
            proxy_pass http://admin_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
        }
        # Admin also serves /api/v1/operator, /api/v1/errors and generic /api/v1 (analytics/support/moderation)
        location /api/v1/operator/ {
            proxy_pass http://admin_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
        }
        location /api/v1/errors/ {
            proxy_pass http://admin_service;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
        }

        # Gateway health
        location = /health {
            default_type application/json;
            return 200 '{"status":"ok","service":"gateway"}';
        }
    }
}
