NODE_ENV=development
PORT=3004
MONGO_URI=mongodb://cinesync:cinesync_dev_pass@localhost:27017/cinesync_watch_party?authSource=admin
REDIS_URL=redis://:cinesync_redis_pass@localhost:6379
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Logging
LOG_LEVEL=debug

# Internal service communication
INTERNAL_SECRET=your-internal-secret-key

# Virtual brauzer: mintaqaviy cheklangan saytlar ("VPN talab qilinadi", masalan asilmedia.org O'zbekiston IP sini bloklaydi)
# uchun ixtiyoriy proksi. Faqat VB_PROXY_DOMAINS dagi domenlar proksi orqali ochiladi. Server (Railway) O'zbekistondan
# tashqarida bo'lsa kerak emas; lokal ishlab chiqishda proksi YOKI kompyuterning o'zida VPN yoqing.
# VB_PROXY_SERVER=http://host:port
# VB_PROXY_USERNAME=
# VB_PROXY_PASSWORD=
# VB_PROXY_DOMAINS=asilmedia.org
