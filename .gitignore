# Claude CLI — lokal fayllar (skills, scripts, agents, commands shared)
.claude/*
!.claude/skills/
!.claude/scripts/
!.claude/agents/
!.claude/commands/
!.claude/settings.json
.claude/locks/
.claude/settings.local.json
.claude/statsig/
.claude/todos/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables — NEVER commit
# Catch-all first: previous pattern set (.env / .env.local / .env.*.local) only
# matched suffixes ending in ".local" — a file like ".env.local.railway-backup"
# (real Railway secrets, found untracked in apps/app-web/ during a 2026-08-01
# harness audit) fell through every one of those patterns. ".env*" covers any
# name starting with .env regardless of what comes after.
.env*
!.env.example
!.env.dev.example

# Logs
logs/
*.log

# Build output
dist/
build/
.next/
out/

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Uploads
uploads/

# SSL certs
nginx/ssl/

# Firebase service account
firebase-adminsdk*.json

# Test coverage
coverage/

# Playwright
playwright-report/
test-results/*
!test-results/.gitkeep
screenshots/*
!screenshots/.gitkeep

# React Native
apps/mobile/android/.gradle/
apps/mobile/android/app/build/
apps/mobile/ios/build/
apps/mobile/ios/Pods/

# Test artifacts / junk
.playwright-mcp/

# Telegram/Telethon auth sessions — secrets, never commit
*.session
*.session-journal

# APK build artifacts (never commit — regenerate via eas build)
*.apk
