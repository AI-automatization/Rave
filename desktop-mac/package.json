{
  "name": "wewatch-desktop-mac",
  "productName": "WeWatch",
  "version": "0.1.0",
  "private": true,
  "description": "WeWatch for macOS \u2014 the web app plus a Virtual Browser that runs on the owner's own machine",
  "main": "dist/main/index.js",
  "author": "WeWatch",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-renderer.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "vitest run",
    "smoke:m2b": "npm run build && node test/smoke/m2b.mjs",
    "smoke:m3": "npm run build && node test/smoke/m3.mjs",
    "smoke:m4": "npm run build && node test/smoke/m4.mjs",
    "smoke:m5": "npm run build && node test/smoke/m5.mjs",
    "smoke:m5b": "npm run build && node test/smoke/m5b.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && WW_APP_URL=http://localhost:3000 electron .",
    "dist": "npm run build && npm run build:web && electron-builder --mac",
    "build:web": "bash scripts/build-web.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.20.3"
  }
}
