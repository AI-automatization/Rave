{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_AUTH_URL": "https://your-auth-service.up.railway.app/api/v1",
        "EXPO_PUBLIC_USER_URL": "https://your-user-service.up.railway.app/api/v1",
        "EXPO_PUBLIC_CONTENT_URL": "https://your-content-service.up.railway.app/api/v1",
        "EXPO_PUBLIC_NOTIFICATION_URL": "https://your-notification-service.up.railway.app/api/v1",
        "EXPO_PUBLIC_WATCH_PARTY_URL": "https://your-watch-party-service.up.railway.app",
        "EXPO_PUBLIC_BATTLE_URL": "https://your-battle-service.up.railway.app/api/v1",
        "EXPO_PUBLIC_ADMIN_URL": "https://your-admin-service.up.railway.app/api/v1"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_AUTH_URL": "https://your-auth-service.up.railway.app/api/v1",
        "EXPO_PUBLIC_USER_URL": "https://your-user-service.up.railway.app/api/v1",
        "EXPO_PUBLIC_CONTENT_URL": "https://your-content-service.up.railway.app/api/v1",
        "EXPO_PUBLIC_NOTIFICATION_URL": "https://your-notification-service.up.railway.app/api/v1",
        "EXPO_PUBLIC_WATCH_PARTY_URL": "https://your-watch-party-service.up.railway.app",
        "EXPO_PUBLIC_BATTLE_URL": "https://your-battle-service.up.railway.app/api/v1",
        "EXPO_PUBLIC_ADMIN_URL": "https://your-admin-service.up.railway.app/api/v1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_AUTH_URL": "https://your-auth-service.up.railway.app/api/v1",
        "EXPO_PUBLIC_USER_URL": "https://your-user-service.up.railway.app/api/v1",
        "EXPO_PUBLIC_CONTENT_URL": "https://your-content-service.up.railway.app/api/v1",
        "EXPO_PUBLIC_NOTIFICATION_URL": "https://your-notification-service.up.railway.app/api/v1",
        "EXPO_PUBLIC_WATCH_PARTY_URL": "https://your-watch-party-service.up.railway.app",
        "EXPO_PUBLIC_BATTLE_URL": "https://your-battle-service.up.railway.app/api/v1",
        "EXPO_PUBLIC_ADMIN_URL": "https://your-admin-service.up.railway.app/api/v1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-services-key.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "",
        "ascAppId": "",
        "appleTeamId": ""
      }
    }
  }
}
