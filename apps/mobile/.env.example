# ============================================================
# CineSync Mobile — Environment Variables template
# Nusxa ko'chirish: cp .env.example .env
# DIQQAT: .env faylini hech qachon git ga push qilma!
# ============================================================

# --- Backend API URLs ---
# Railway production URLs: Settings → Variables in Railway dashboard
EXPO_PUBLIC_AUTH_URL=https://your-auth-service.up.railway.app/api/v1
EXPO_PUBLIC_USER_URL=https://your-user-service.up.railway.app/api/v1
EXPO_PUBLIC_CONTENT_URL=https://your-content-service.up.railway.app/api/v1
EXPO_PUBLIC_NOTIFICATION_URL=https://your-notification-service.up.railway.app/api/v1
EXPO_PUBLIC_WATCH_PARTY_URL=https://your-watch-party-service.up.railway.app
EXPO_PUBLIC_BATTLE_URL=https://your-battle-service.up.railway.app/api/v1
EXPO_PUBLIC_ADMIN_URL=https://your-admin-service.up.railway.app/api/v1

# --- Google OAuth ---
# Google Cloud Console → APIs & Services → Credentials
# Web Client ID (iOS va Expo Go uchun):
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# Android Client ID (SHA-1 fingerprint kerak):
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
# iOS Client ID (Bundle ID: com.cinesync.app):
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com

# --- Mobile Error Logging ---
# Match MOBILE_ERROR_KEY env var on Railway admin service
EXPO_PUBLIC_ERROR_KEY=your_error_key

# --- Expo Push Notifications ---
# Expo Dashboard → Project → Project ID (UUID format)
EXPO_PUBLIC_PROJECT_ID=your-expo-project-uuid

# --- Sentry (optional) ---
# sentry.io → Project → Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=https://your_key@oXXXXXX.ingest.sentry.io/XXXXXXX
