# docker-compose.dev.yml uchun environment variables
# Bu faylni ko'chirib: cp .env.dev.example .env.dev
# .env.dev ni hech qachon git ga commit QILMANG

MONGO_ROOT_USER=cinesync
MONGO_ROOT_PASSWORD=change_me_dev_mongo_pass
MONGO_DB=cinesync

REDIS_PASSWORD=change_me_dev_redis_pass

# NextAuth (web service)
NEXTAUTH_SECRET=change_me_nextauth_secret

# Playwright E2E — prod service URLs (only set when running against production)
TEST_AUTH_URL=https://auth-production-xxx.up.railway.app
TEST_USER_URL=https://user-production-xxx.up.railway.app
TEST_CONTENT_URL=https://content-production-xxx.up.railway.app
TEST_WATCH_PARTY_URL=https://watch-part-production.up.railway.app
TEST_BATTLE_URL=https://battle-production-xxx.up.railway.app
TEST_NOTIFICATION_URL=https://notification-production-xxx.up.railway.app
TEST_ADMIN_URL=https://admin-production-xxx.up.railway.app
